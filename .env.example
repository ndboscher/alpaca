# Get keys at https://app.alpaca.markets  ->  (Paper account) -> API Keys
# Paper keys and live keys are different. Start with paper.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here

# true = paper trading (fake money). Set to false ONLY when you are ready for real money,
# and you must also set `live_trading_confirmed: true` in config.yaml.
ALPACA_PAPER=true
